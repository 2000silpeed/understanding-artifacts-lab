     "    root = v"
    ],
    [
     36,
     "    while self.parent[root] != root:      # 대표까지 따라 올라간다"
    ],
    [
     37,
     "        root = self.parent[root]"
    ],
    [
     38,
     "    while v != root:                      # 지나온 정점은 대표를 바로 가리키게(경로 압축)"
    ],
    [
     39,
     "        nxt = self.parent[v]"
    ],
    [
     40,
     "        self.parent[v] = root"
    ],
    [
     41,
     "        v = nxt"
    ],
    [
     42,
     "    return root"
    ]
   ]
