     "def kruskal(names, edges, log=None):"
    ],
    [
     57,
     "    uf = UnionFind(names)"
    ],
    [
     58,
     "    tree, total, checked = [], 0, 0"
    ],
    [
     59,
     "    for u, v, w in sorted(edges, key=lambda e: e[2]):   # 비용 순서(같으면 입력 순서)"
    ],
    [
     60,
     "        if len(tree) == len(names) - 1:"
    ],
    [
     61,
     "            break                                       # 간선 n-1개면 끝"
    ],
    [
     62,
     "        checked += 1"
    ],
    [
     63,
     "        ru, rv = uf.find(u), uf.find(v)                 # 두 끝의 대표"
    ],
    [
     64,
     "        take = uf.union(u, v)                           # 대표가 다르면 잇는다"
    ],
    [
     65,
     "        if take:"
    ],
    [
     66,
     "            tree.append((u, v, w))"
    ],
    [
     67,
     "            total += w"
    ],
    [
     71,
