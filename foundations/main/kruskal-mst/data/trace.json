     44,
     "def union(self, a, b):"
    ],
    [
     45,
     "    ra, rb = self.find(a), self.find(b)"
    ],
    [
     46,
     "    if ra == rb:"
    ],
    [
     47,
     "        return False                      # 같은 덩어리: 이으면 사이클"
    ],
    [
     48,
     "    if self.size[ra] < self.size[rb]:"
    ],
    [
     49,
     "        ra, rb = rb, ra"
    ],
    [
     50,
     "    self.parent[rb] = ra                  # 작은 덩어리를 큰 덩어리 아래에"
    ],
    [
     51,
     "    self.size[ra] += self.size[rb]"
    ],
    [
     52,
     "    return True"
    ]
