   "line": 50,
   "text": "def prim(names, edges, start=0):"
  },
  {
   "line": 51,
   "text": "    \"\"\"Lazy Prim with a binary heap. Returns the full event log the film draws from.\"\"\""
  },
  {
   "line": 52,
   "text": "    n = len(names)"
  },
  {
   "line": 53,
   "text": "    adj = adjacency(n, edges)"
  },
  {
   "line": 54,
   "text": "    in_tree = [False] * n"
  },
  {
   "line": 55,
   "text": "    heap, seq = [], 0"
  },
  {
   "line": 56,
   "text": "    events, taken = [], []"
  },
  {
   "line": 57,
   "text": ""
  },
  {
   "line": 58,
   "text": "    def add(x):"
  },
  {
   "line": 59,
   "text": "        nonlocal seq"
  },
  {
   "line": 60,
   "text": "        in_tree[x] = True"
  },
  {
   "line": 61,
   "text": "        pushed = []"
  },
  {
   "line": 62,
   "text": "        for y, w in adj[x]:"
  },
  {
   "line": 63,
   "text": "            if not in_tree[y]:           # an edge back into the tree is never a candidate"
  },
  {
   "line": 64,
   "text": "                heapq.heappush(heap, (w, seq, x, y))"
  },
  {
   "line": 65,
   "text": "                pushed.append((w, seq, x, y))"
  },
  {
   "line": 66,
   "text": "                seq += 1"
  },
  {
   "line": 67,
   "text": "        return pushed"
  },
  {
   "line": 68,
   "text": ""
  },
  {
   "line": 69,
   "text": "    pushed = add(start)"
  },
  {
   "line": 70,
   "text": "    events.append({'kind': 'start', 'v': start, 'pushed': pushed, 'heapAfter': sorted(heap)})"
  },
  {
   "line": 71,
   "text": "    while heap and len(taken) < n - 1:"
  },
  {
   "line": 72,
   "text": "        before = sorted(heap)"
  },
  {
   "line": 73,
   "text": "        w, s, x, y = heapq.heappop(heap)"
  },
  {
   "line": 74,
   "text": "        if in_tree[y]:                   # both ends already in the tree: would close a cycle"
  },
  {
   "line": 75,
   "text": "            events.append({'kind': 'skip', 'edge': (x, y, w), 'seq': s, 'heapBefore': before, 'heapAfter': sorted(heap)})"
  },
  {
   "line": 76,
   "text": "            continue"
  },
  {
   "line": 77,
   "text": "        taken.append((x, y, w))"
  },
  {
   "line": 78,
   "text": "        pushed = add(y)"
  },
  {
   "line": 79,
   "text": "        events.append({'kind': 'take', 'edge': (x, y, w), 'seq': s, 'heapBefore': before,"
  },
  {
   "line": 80,
   "text": "                       'pushed': pushed, 'heapAfter': sorted(heap), 'tree': sum(in_tree)})"
  },
  {
   "line": 81,
   "text": "    return {'start': start, 'events': events, 'taken': taken, 'total': sum(w for _, _, w in taken),"
  }
 ]
