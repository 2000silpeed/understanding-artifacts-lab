 "code": {
  "python": {
   "dfs": [
    "def find_bridges(adj, n):",
    "    tin, low = [0] * n, [0] * n",
    "    timer, found = 0, []",
    "    for root in range(n):",
    "        if tin[root]:",
    "            continue",
    "        timer += 1",
    "        tin[root] = low[root] = timer",
    "        stack = [(root, -1, iter(adj[root]))]",
    "        while stack:",
    "            v, pe, it = stack[-1]",
    "            nxt = next(it, None)",
    "            if nxt is None:      # v is done",
    "                stack.pop()",
    "                if stack:",
    "                    u = stack[-1][0]",
    "                    low[u] = min(low[u], low[v])",
    "                    if low[v] > tin[u]:",
    "                        found.append(pe)",
    "                continue",
    "            w, e = nxt",
    "            if e == pe:          # came in by it",
    "                continue",
    "            if tin[w]:           # back edge",
    "                low[v] = min(low[v], tin[w])",
    "            else:                # tree edge",
    "                timer += 1",
    "                tin[w] = low[w] = timer",
    "                stack.append((w, e, iter(adj[w])))",
    "    return found, tin, low"
   ]
  },
  "cpp": {
   "dfs": [
    "struct Frame { int v, pe; size_t i; };",
    "std::vector<Frame> st{{root, -1, 0}};",
    "while (!st.empty()) {",
    "  Frame& f = st.back();",
    "  int v = f.v;",
    "  if (f.i == adj[v].size()) {  // v is done",
    "    int pe = f.pe;",
    "    st.pop_back();",
    "    if (st.empty()) continue;",
    "    int u = st.back().v;",
    "    r.low[u] = std::min(r.low[u], r.low[v]);",
    "    if (r.low[v] > r.tin[u]) r.found.push_back(pe);",
    "    continue;",
    "  }",
    "  auto [w, e] = adj[v][f.i++];",
    "  if (skipVertex ? w == r.parent[v] : e == f.pe)",
    "    continue;                  // came in by it",
    "  if (r.tin[w]) {              // back edge",
    "    r.low[v] = std::min(r.low[v], r.tin[w]);",
    "  } else {                     // tree edge",
    "    r.tin[w] = r.low[w] = ++timer;",
    "    r.up[w] = e; r.parent[w] = v;",
    "    st.push_back({w, e, 0});",
    "  }",
    "}"
   ]
