        "def articulation_points(n, edges):",
        "    adj = build_adj(n, edges)              # adj[u] = [(이웃 v, 간선 번호 e), ...]",
        "    disc, low = [-1] * n, [0] * n",
        "    cut, timer = set(), 0",
        "",
        "    def dfs(u, parent_edge):",
        "        nonlocal timer",
        "        disc[u] = low[u] = timer           # 방문 번호",
        "        timer += 1",
        "        children = 0",
        "        for v, e in adj[u]:",
        "            if e == parent_edge:           # 방금 타고 온 간선은 건너뛴다",
        "                continue",
        "            if disc[v] != -1:              # 이미 방문: 뒤로 가는 간선",
        "                low[u] = min(low[u], disc[v])",
        "            else:                          # 트리 간선: 자식으로 내려간다",
        "                children += 1",
        "                dfs(v, e)",
        "                low[u] = min(low[u], low[v])",
        "                if parent_edge != -1 and low[v] >= disc[u]:",
        "                    cut.add(u)             # 자식이 u 위로 못 올라감",
        "        if parent_edge == -1 and children >= 2:",
        "            cut.add(u)                     # 루트: 자식이 둘 이상",
        "",
        "    for s in range(n):",
        "        if disc[s] == -1:",
        "            dfs(s, -1)",
        "    return sorted(cut)"
